{
  "name": "teyvat-personality",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "validate:data": "node scripts/validate-data.mjs",
    "verify:engine": "node scripts/verify-engine.mjs",
    "verify:consent": "node scripts/verify-consent.mjs",
    "simulate:balance": "node scripts/simulate-balance.mjs",
    "verify:shared-result": "firebase emulators:exec --project demo-teyvat-personality --only firestore \"node scripts/verify-shared-result.mjs\"",
    "build": "node scripts/validate-data.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "latest",
    "lucide-react": "latest",
    "nanoid": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@firebase/rules-unit-testing": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "firebase-tools": "latest",
    "globals": "^16.5.0",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.1"
  }
}
