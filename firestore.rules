rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedResults/{id} {
      allow get: if true;
      allow list: if false;

      allow create: if
        id.matches('^[A-Za-z0-9_-]{12}$') &&
        (isValidVersionOne(request.resource.data) || isValidVersionTwo(request.resource.data));

      allow update: if false;
      allow delete: if false;
    }

    function hasValidCommonFields(data) {
      return data.keys().hasAll([
          'schemaVersion', 'questionVersion', 'algorithmVersion',
          'publishedAt', 'character', 'vision'
        ]) &&
        data.questionVersion is string &&
        data.algorithmVersion is string &&
        data.publishedAt == request.time &&
        isValidCharacter(data.character) &&
        isValidVision(data.vision);
    }

    function isValidVersionOne(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'questionVersion', 'algorithmVersion',
          'publishedAt', 'character', 'vision'
        ]) &&
        data.schemaVersion == 1 &&
        hasValidCommonFields(data);
    }

    function isValidVersionTwo(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'questionVersion', 'algorithmVersion',
          'publishedAt', 'character', 'additionalCharacters', 'vision'
        ]) &&
        data.schemaVersion == 2 &&
        data.additionalCharacters is list &&
        data.additionalCharacters.size() == 3 &&
        isValidCharacter(data.additionalCharacters[0]) &&
        isValidCharacter(data.additionalCharacters[1]) &&
        isValidCharacter(data.additionalCharacters[2]) &&
        hasValidCommonFields(data);
    }

    function isValidCharacter(c) {
      return c.keys().hasAll([
          'characterId', 'name', 'element', 'region', 'compatibility',
          'title', 'summary', 'matchingTraits', 'artworkUrl'
        ])
        && c.keys().hasOnly([
          'characterId', 'name', 'element', 'region', 'compatibility',
          'title', 'summary', 'matchingTraits', 'artworkUrl'
        ])
        && c.characterId is string && c.name is string
        && c.element is string && c.region is string
        && c.compatibility is int && c.compatibility >= 0 && c.compatibility <= 100
        && isLocalizedText(c.title) && isLocalizedText(c.summary)
        && c.matchingTraits is list
        && (c.artworkUrl == null || c.artworkUrl is string);
    }

    function isValidVision(v) {
      return v.keys().hasAll(['element', 'affinity', 'summary'])
        && v.keys().hasOnly(['element', 'affinity', 'summary'])
        && v.element is string
        && v.affinity is int && v.affinity >= 0 && v.affinity <= 100
        && isLocalizedText(v.summary);
    }

    function isLocalizedText(t) {
      return t.keys().hasAll(['th', 'en'])
        && t.keys().hasOnly(['th', 'en'])
        && t.th is string && t.en is string;
    }
  }
}
